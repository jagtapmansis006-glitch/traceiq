{
  "name": "TraceIQ Remediation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "traceiq-remediate",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "r1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "traceiq-remediate-hook"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst incident_id = String(b.incident_id || '').trim();\nconst action_id = String(b.action_id || '').trim();\nif (!incident_id || !action_id) { throw new Error('incident_id and action_id are required'); }\nreturn [{ json: { incident_id, action_id } }];"
      },
      "id": "r2",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/api/remediate",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ incident_id: $json.incident_id, action_id: $json.action_id }) }}"
      },
      "id": "r3",
      "name": "Call Remediate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/api/verify",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ incident_id: $('Validate Input').first().json.incident_id }) }}"
      },
      "id": "r4",
      "name": "Call Verify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const rem = $('Call Remediate').first().json;\nconst ver = $input.first().json;\nreturn [{ json: {\n  incident_id: $('Validate Input').first().json.incident_id,\n  action_id: $('Validate Input').first().json.action_id,\n  status: rem.status,\n  message: rem.message,\n  before: rem.before,\n  after: rem.after,\n  verified: ver.verified === true,\n  resolved: ver.status === 'resolved'\n}}];"
      },
      "id": "r5",
      "name": "Shape Remediation Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "r6",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: {\n  incident_id: $('Validate Input').first().json.incident_id ?? null,\n  status: 'failed',\n  error: 'Remediation or verification failed: engine unreachable or returned an error',\n  processed_at: new Date().toISOString()\n}}];"
      },
      "id": "r7",
      "name": "Shape Error Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        160
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "r8",
      "name": "Respond Error 502",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { status: 'failed', error: 'incident_id and action_id are required' } }];"
      },
      "id": "r9",
      "name": "Shape Bad Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "r10",
      "name": "Respond Bad Request 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Input": {
      "main": [
        [
          {
            "node": "Call Remediate",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Shape Bad Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Remediate": {
      "main": [
        [
          {
            "node": "Call Verify",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Shape Error Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Verify": {
      "main": [
        [
          {
            "node": "Shape Remediation Output",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Shape Error Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape Remediation Output": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape Error Output": {
      "main": [
        [
          {
            "node": "Respond Error 502",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape Bad Request": {
      "main": [
        [
          {
            "node": "Respond Bad Request 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}