        "options": { "timeout": 15000 }
      },
      "id": "t2",
      "name": "Get Timeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": { "responseCode": 200 }
      },
      "id": "t3",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Get Timeline", "type": "main", "index": 0 }]] },
    "Get Timeline": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
