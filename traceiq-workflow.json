    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst label = String(r.confidence ?? 'Low');\nconst pctMap = { high: 90, medium: 60, low: 30 };\nconst rawPct = Number(r.confidence_pct);\nconst confidence_pct = (r.confidence_pct != null && Number.isFinite(rawPct))\n  ? Math.max(0, Math.min(100, Math.round(rawPct)))\n  : (pctMap[label.toLowerCase()] ?? 0);\nconst hyps = r.hypotheses_evaluated ?? [];\nconst evidence = Array.isArray(r.evidence)\n  ? r.evidence\n  : hyps.filter(h => ['SUPPORTED', 'PLAUSIBLE'].includes(String(h.status).toUpperCase())).map(h => h.reason);\nconst out = {\n  incident_id: r.incident_id,\n  service: r.service,\n  status: r.status,\n  source: r.source ?? 'unknown',\n  root_cause: String(r.root_cause ?? '').replace(/\\s*\\(Error:[\\s\\S]*\\)\\s*$/, ''),\n  confidence: label,\n  confidence_pct,\n  timeline: r.timeline ?? [],\n  hypotheses_evaluated: hyps,\n  evidence,\n  recommended_actions: r.recommended_actions ?? [],\n  processed_at: new Date().toISOString()\n};\nif (r.similar_past_incident != null) out.similar_past_incident = r.similar_past_incident;\nif (r.memory_source != null) out.memory_source = r.memory_source;\nreturn [{ json: out }];"
      },
